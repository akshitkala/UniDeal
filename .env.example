# Supabase (Auth + DB)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary (Image Hosting)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
# Optional — signed destroy calls for best-effort image cleanup on account deletion;
# when unset, the cleanup is skipped and logged server-side only.
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Security & Cron
CRON_SECRET=your-random-cron-secret-string

# Transactional Email (Support Form /api/contact)
RESEND_API_KEY=re_your_resend_api_key
CONTACT_EMAIL=support@unideal.app
