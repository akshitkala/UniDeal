e":"</_next/static/media/7b0b24f36b1a6d0b-s.p.woff2>; rel=preload; as=\"font\"; crossorigin=\"\"; type=\"font/woff2\", </_next/static/media/c9e6921c7fc300d8-s.p.woff2>; rel=preload; as=\"font\"; crossorigin=\"\"; type=\"font/woff2\""},{"name":"server","value":"Vercel"},{"name":"strict-transport-security","value":"max-age=63072000; includeSubDomains; preload"},{"name":"vary","value":"RSC, Next-Router-State-Tree, Next-Router-Prefetch"},{"name":"x-matched-path","value":"/"},{"name":"x-powered-by","value":"Next.js"},{"name":"x-vercel-cache","value":"MISS"},{"name":"x-vercel-id","value":"bom1::sin1::7tg67-1791189406743-a416a3a5e84b"}],"content":{"size":55702,"mimeType":"text/html; charset=utf-8","compression":46750,"text":"<!DOCTYPE html><html lang=\"en\" class=\"__variable_a2025e __variable_ed3508\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/3f8135dc5fc5a432.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-f69a931931267d18.js\"/><script src=\"/_next/static/chunks/fd9d1056-1087d9c94f014549.js\" async=\"\"></script><script src=\"/_next/static/chunks/117-49d71e9c46ed44c4.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-2dcde4753ea0d175.js\" async=\"\"></script><script src=\"/_next/static/chunks/648-e6a5e95ed82680cc.js\" async=\"\"></script><script src=\"/_next/static/chunks/780-526f81bebb9b42a1.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/(public)/page-89a39dd700d415b3.js\" async=\"\"></script><script src=\"/_next/static/chunks/44530001-95ff11e920d3b226.js\" async=\"\"></script><script src=\"/_next/static/chunks/26-698648aab4d3fdee.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-9b4e58f939eb087c.js\" async=\"\"></script><title>UniDeal — Campus Marketplace</title><meta name=\"description\" content=\"Buy and sell physical items with verified students on your university campus. No buried WhatsApp messages.\"/><meta name=\"next-size-adjust\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"min-h-screen bg-white text-neutral-text font-body antialiased flex flex-col\"><header class=\"sticky top-0 z-40 bg-white border-b border-border\"><div class=\"container mx-auto px-4 h-16 flex items-center justify-between\"><a class=\"flex items-center gap-2 text-xl font-bold tracking-tight text-neutral-text font-heading\" href=\"/\"><span class=\"w-8 h-8 rounded-md bg-primary text-white flex items-center justify-center font-display font-extrabold text-lg\">U</span><span>UniDeal</span></a><nav class=\"hidden md:flex items-center gap-6\"><a class=\"text-sm font-medium transition-colors hover:text-primary text-neutral-text\" href=\"/browse\">Browse</a><a class=\"text-sm font-medium transition-colors hover:text-primary text-neutral-muted\" href=\"/how-it-works\">How It Works</a><a class=\"text-sm font-medium transition-colors hover:text-primary text-neutral-muted\" href=\"/our-story\">Our Story</a><a class=\"text-sm font-medium transition-colors hover:text-primary text-neutral-muted\" href=\"/contact\">Contact Us</a></nav><div class=\"hidden md:flex items-center gap-3\"><a class=\"py-2 px-3.5 bg-primary text-white rounded-md font-medium text-sm hover:bg-primary-hover focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors min-h-[40px] flex items-center gap-1.5 shadow-sm\" href=\"/sell\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-plus w-4 h-4\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M8 12h8\"></path><path d=\"M12 8v8\"></path></svg><span>Sell Item</span></a><button type=\"button\" class=\"py-2 px-3.5 bg-white text-neutral-text border border-border rounded-md font-medium text-sm hover:bg-surface focus:outline-none focus:ring-2 focus:ring-primary transition-colors min-h-[40px]\">Sign In</button></div><div class=\"md:hidden flex items-center gap-2\"><button type=\"button\" class=\"py-1.5 px-3 bg-white text-neutral-text border border-border rounded-md font-medium text-sm hover:bg-surface focus:outline-none focus:ring-2 focus:ring-primary min-h-[40px]\">Sign In</button><button type=\"button\" class=\"p-2 text-neutral-text hover:bg-surface rounded-md focus:outline-none focus:ring-2 focus:ring-primary min-w-[44px] min-h-[44px] flex items-center justify-center\" aria-label=\"Toggle menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu w-6 h-6\"><line x1=\"4\" x2=\"20\" y1=\"12\" y2=\"12\"></line><line x1=\"4\" x2=\"20\" y1=\"6\" y2=\"6\"></line><line x1=\"4\" x2=\"20\" y1=\"18\" y2=\"18\"></line></svg></button></div></div></header><div class=\"flex-1 flex flex-col\"><main class=\"flex-1 flex flex-col\"><section class=\"bg-white border-b border-border overflow-hidden\"><div class=\"container mx-auto px-4 py-16 sm:py-24 max-w-5xl\"><div class=\"flex flex-col lg:flex-row items-center gap-12 lg:gap-16\"><div class=\"flex-1 text-center lg:text-left space-y-6\"><div style=\"opacity:0;transform:translateY(24px)\"><span class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-primary/20 bg-primary/5 text-xs font-semibold text-primary mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check w-3.5 h-3.5\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg>Verified students only</span><h1 class=\"text-4xl sm:text-5xl font-extrabold tracking-tight text-neutral-text font-display leading-tight\">Buy and sell on campus<br/><span class=\"text-primary\">without the chaos.</span></h1></div><p class=\"text-lg text-neutral-muted max-w-md mx-auto lg:mx-0\" style=\"opacity:0;transform:translateY(16px)\">No buried WhatsApp messages. No anonymous strangers. A structured, searchable marketplace built for university life.</p><div class=\"flex flex-col sm:flex-row gap-3 justify-center lg:justify-start\" style=\"opacity:0;transform:translateY(12px)\"><a class=\"py-3 px-6 bg-primary text-white rounded-md font-semibold text-base hover:bg-primary-hover focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors duration-200 min-h-[44px] flex items-center justify-center\" href=\"/browse\">Browse Listings</a><a class=\"py-3 px-6 bg-white text-neutral-text border border-border rounded-md font-semibold text-base hover:bg-surface focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors duration-200 min-h-[44px] flex items-center justify-center\" href=\"/sell\">Sell an Item</a></div><div class=\"flex items-center gap-6 justify-center lg:justify-start pt-4 border-t border-border\" style=\"opacity:0\"><div class=\"flex flex-col items-center\" style=\"opacity:0;transform:scale(0.92)\"><span class=\"text-2xl font-extrabold text-neutral-text font-display\">₹0</span><span class=\"text-xs text-neutral-muted mt-0.5\">Always free</span></div><div class=\"w-px h-8 bg-border\" aria-hidden=\"true\"></div><div class=\"flex flex-col items-center\" style=\"opacity:0;transform:scale(0.92)\"><span class=\"text-2xl font-extrabold text-neutral-text font-display\">6</span><span class=\"text-xs text-neutral-muted mt-0.5\">Categories</span></div><div class=\"w-px h-8 bg-border\" aria-hidden=\"true\"></div><div class=\"flex flex-col items-center\" style=\"opacity:0;transform:scale(0.92)\"><span class=\"text-2xl font-extrabold text-neutral-text font-display\">1-tap</span><span class=\"text-xs text-neutral-muted mt-0.5\">WhatsApp connect</span></div></div></div><div class=\"hidden lg:flex flex-shrink-0 w-72 h-72 relative items-center justify-center\" aria-hidden=\"true\" style=\"opacity:0;transform:translateY(6px)\"><div class=\"absolute inset-0 flex items-center justify-center\"><div class=\"w-24 h-24 rounded-full border-2 border-primary/20 bg-primary/5 flex items-center justify-center\" style=\"opacity:0;transform:scale(0.8)\"><span class=\"text-3xl font-extrabold text-primary font-display\">U</span></div><div class=\"absolute inset-0\"><div class=\"absolute top-4 left-1/2 -translate-x-1/2\" style=\"opacity:0;transform:translateY(12px)\"><div class=\"flex items-center gap-2 px-3 py-2 bg-white border border-border rounded-full text-xs font-medium text-neutral-text select-none\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-tag w-3.5 h-3.5 text-primary flex-shrink-0\" aria-hidden=\"true\"><path d=\"M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z\"></path><circle cx=\"7.5\" cy=\"7.5\" r=\".5\" fill=\"currentColor\"></circle></svg>List in 2 min</div></div><div class=\"absolute top-1/2 right-0 -translate-y-1/2\" style=\"opacity:0;transform:translateY(12px)\"><div class=\"flex items-center gap-2 px-3 py-2 bg-white border border-border rounded-full text-xs font-medium text-neutral-text select-none\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-search w-3.5 h-3.5 text-primary flex-shrink-0\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><path d=\"m21 21-4.3-4.3\"></path></svg>Search &amp; filter</div></div><div class=\"absolute bottom-4 left-1/2 -translate-x-1/2\" style=\"opacity:0;transform:translateY(12px)\"><div class=\"flex items-center gap-2 px-3 py-2 bg-white border border-border rounded-full text-xs font-medium text-neutral-text select-none\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-message-circle w-3.5 h-3.5 text-primary flex-shrink-0\" aria-hidden=\"true\"><path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\"></path></svg>WhatsApp connect</div></div><div class=\"absolute top-1/2 left-0 -translate-y-1/2\" style=\"opacity:0;transform:translateY(12px)\"><div class=\"flex items-center gap-2 px-3 py-2 bg-white border border-border rounded-full text-xs font-medium text-neutral-text select-none\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check w-3.5 h-3.5 text-primary flex-shrink-0\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg>Verified students</div></div></div><div class=\"absolute w-48 h-48 rounded-full border border-dashed border-border\" style=\"opacity:0\"></div></div></div></div></div></section><section class=\"bg-surface border-b border-border\"><div class=\"container mx-auto px-4 py-16 max-w-5xl\"><div class=\"mb-10\" style=\"opacity:0;transform:translateY(16px)\"><p class=\"text-xs font-semibold text-primary uppercase tracking-widest mb-2\">The problem</p><h2 class=\"text-2xl sm:text-3xl font-bold text-neutral-text font-heading\">WhatsApp groups weren’t built for this.</h2></div><ul class=\"grid sm:grid-cols-3 gap-6\" aria-label=\"Problems with WhatsApp groups\"><li class=\"flex flex-col gap-3 p-5 rounded-lg border border-border bg-white\" style=\"opacity:0;transform:translateY(16px)\"><div class=\"w-9 h-9 rounded-md bg-danger/8 text-danger flex items-center justify-center flex-shrink-0\" aria-hidden=\"true\" style=\"opacity:0;transform:scale(0.8)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-message-square-x w-4.5 h-4.5\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"></path><path d=\"m14.5 7.5-5 5\"></path><path d=\"m9.5 7.5 5 5\"></path></svg></div><div><h3 class=\"text-sm font-semibold text-neutral-text mb-1\">Listings vanish in hours</h3><p class=\"text-sm text-neutral-muted leading-relaxed\">A post in a WhatsApp group gets buried under 40 messages by noon. Even great deals disappear before the right buyer sees them.</p></div></li><li class=\"flex flex-col gap-3 p-5 rounded-lg border border-border bg-white\" style=\"opacity:0;transform:translateY(-16px)\"><div class=\"w-9 h-9 rounded-md bg-danger/8 text-danger flex items-center justify-center flex-shrink-0\" aria-hidden=\"true\" style=\"opacity:0;transform:scale(0.8)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-eye-off w-4.5 h-4.5\"><path d=\"M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49\"></path><path d=\"M14.084 14.158a3 3 0 0 1-4.242-4.242\"></path><path d=\"M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143\"></path><path d=\"m2 2 20 20\"></path></svg></div><div><h3 class=\"text-sm font-semibold text-neutral-text mb-1\">Sellers are anonymous</h3><p class=\"text-sm text-neutral-muted leading-relaxed\">There&#x27;s no way to know if the poster is a real student on campus, or if the item actually exists.</p></div></li><li class=\"flex flex-col gap-3 p-5 rounded-lg border border-border bg-white\" style=\"opacity:0;transform:translateY(16px)\"><div class=\"w-9 h-9 rounded-md bg-danger/8 text-danger flex items-center justify-center flex-shrink-0\" aria-hidden=\"true\" style=\"opacity:0;transform:scale(0.8)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-search-x w-4.5 h-4.5\"><path d=\"m13.5 8.5-5 5\"></path><path d=\"m8.5 8.5 5 5\"></path><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><path d=\"m21 21-4.3-4.3\"></path></svg></div><div><h3 class=\"text-sm font-semibold text-neutral-text mb-1\">No way to search or filter</h3><p class=\"text-sm text-neutral-muted leading-relaxed\">Looking for a ₹500 charger? Good luck scrolling through months of messages to find one.</p></div></li></ul><p class=\"mt-8 text-sm text-neutral-muted max-w-xl\" style=\"opacity:0\">UniDeal is the structured layer that was missing — discovery and trust on one clean page, deal still closes on WhatsApp.</p></div></section><section class=\"bg-white border-b border-border\"><div class=\"container mx-auto px-4 py-16 max-w-5xl\"><div class=\"mb-10\" style=\"opacity:0;transform:translateY(16px)\"><p class=\"text-xs font-semibold text-primary uppercase tracking-widest mb-2\">How it works</p><h2 class=\"text-2xl sm:text-3xl font-bold text-neutral-text font-heading\">Three steps from listing to deal.</h2></div><div class=\"relative\"><svg aria-hidden=\"true\" class=\"hidden sm:block absolute top-14 left-[16.6%] right-[16.6%] w-[66.8%] h-0.5 pointer-events-none\" viewBox=\"0 0 100 2\" preserveAspectRatio=\"none\"><line x1=\"0\" y1=\"1\" x2=\"100\" y2=\"1\" stroke=\"currentColor\" stroke-width=\"2\" stroke-dasharray=\"0px 1px\" class=\"text-border\" opacity=\"0\" pathLength=\"1\" stroke-dashoffset=\"0px\"></line></svg><ol class=\"grid sm:grid-cols-3 gap-6 relative z-10\" aria-label=\"How UniDeal works\"><li class=\"group relative flex flex-col gap-4 p-6 rounded-lg border border-border bg-white hover:border-primary/40 hover:bg-primary/[0.02] transition-colors duration-200 focus-within:ring-2 focus-within:ring-primary\" tabindex=\"0\" style=\"opacity:0;transform:translateY(16px)\"><span class=\"absolute top-4 right-4 text-3xl font-extrabold text-neutral-text/5 font-display select-none\" aria-hidden=\"true\">01</span><div class=\"w-10 h-10 rounded-md bg-primary/10 text-primary flex items-center justify-center flex-shrink-0 group-hover:bg-primary/15 transition-colors duration-200\" aria-hidden=\"true\" style=\"opacity:0;transform:scale(0.8)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-package-plus w-5 h-5\"><path d=\"M16 16h6\"></path><path d=\"M19 13v6\"></path><path d=\"M21 10V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l2-1.14\"></path><path d=\"m7.5 4.27 9 5.15\"></path><polyline points=\"3.29 7 12 12 20.71 7\"></polyline><line x1=\"12\" x2=\"12\" y1=\"22\" y2=\"12\"></line></svg></div><div><p class=\"text-[11px] font-semibold text-neutral-muted uppercase tracking-wide mb-1\">Step <!-- -->01</p><h3 class=\"text-base font-semibold text-neutral-text mb-1.5\">List your item</h3><p class=\"text-sm text-neutral-muted leading-relaxed\">Photos, price, condition — done in two minutes.</p></div></li><li class=\"group relative flex flex-col gap-4 p-6 rounded-lg border border-border bg-white hover:border-primary/40 hover:bg-primary/[0.02] transition-colors duration-200 focus-within:ring-2 focus-within:ring-primary\" tabindex=\"0\" style=\"opacity:0;transform:translateY(16px)\"><span class=\"absolute top-4 right-4 text-3xl font-extrabold text-neutral-text/5 font-display select-none\" aria-hidden=\"true\">02</span><div class=\"w-10 h-10 rounded-md bg-primary/10 text-primary flex items-center justify-center flex-shrink-0 group-hover:bg-primary/15 transition-colors duration-200\" aria-hidden=\"true\" style=\"opacity:0;transform:scale(0.8)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-search w-5 h-5\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><path d=\"m21 21-4.3-4.3\"></path></svg></div><div><p class=\"text-[11px] font-semibold text-neutral-muted uppercase tracking-wide mb-1\">Step <!-- -->02</p><h3 class=\"text-base font-semibold text-neutral-text mb-1.5\">Buyer finds it</h3><p class=\"text-sm text-neutral-muted leading-relaxed\">Search, filter by category or condition, sorted by newest or price.</p></div></li><li class=\"group relative flex flex-col gap-4 p-6 rounded-lg border border-border bg-white hover:border-primary/40 hover:bg-primary/[0.02] transition-colors duration-200 focus-within:ring-2 focus-within:ring-primary\" tabindex=\"0\" style=\"opacity:0;transform:translateY(16px)\"><span class=\"absolute top-4 right-4 text-3xl font-extrabold text-neutral-text/5 font-display select-none\" aria-hidden=\"true\">03</span><div class=\"w-10 h-10 rounded-md bg-primary/10 text-primary flex items-center justify-center flex-shrink-0 group-hover:bg-primary/15 transition-colors duration-200\" aria-hidden=\"true\" style=\"opacity:0;transform:scale(0.8)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\