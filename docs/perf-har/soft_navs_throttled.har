,{inView:f.inView}),flip:!0,inView:f.inView})}),(0,n.jsx)(\"div\",{ref:w.ref,className:\"bg-surface\",children:(0,n.jsx)(v,{label:\"03 — The Gap\",heading:\"Supply and demand existed. The connection didn't.\",pullQuote:\"The right two people were both on campus — they just couldn't find each other.\",body:\"This wasn't a niche problem. Every semester, across every hostel block: sellers with good stuff, buyers who needed exactly that stuff, and no reliable way to bridge them. The gap wasn't a lack of items — it was a lack of infrastructure.\",illustration:(0,n.jsx)(u,{inView:w.inView}),inView:w.inView})}),(0,n.jsx)(\"div\",{ref:j.ref,className:\"bg-white\",children:(0,n.jsx)(v,{label:\"04 — Why Not OLX?\",heading:\"City marketplaces weren't built for campus trust.\",body:\"OLX and similar platforms work at city scale — where you meet strangers. Campus is different. Proximity and shared context are the trust signal. A verified student two blocks away is a fundamentally different seller than an anonymous city listing. No existing platform understood that distinction.\",illustration:(0,n.jsx)(m,{inView:j.inView}),flip:!0,inView:j.inView,children:(0,n.jsx)(o.E.div,{variants:e(d.offset.sm,d.duration.entrance,.18),className:\"mt-2\",children:(0,n.jsx)(\"div\",{className:\"p-4 rounded-lg border border-border bg-surface text-sm text-neutral-muted leading-relaxed\",children:\"UniDeal isn’t competing with OLX. It’s solving a problem OLX doesn’t have — intra-campus trust at walking distance.\"})})})}),(0,n.jsx)(\"div\",{ref:b.ref,className:\"bg-surface\",children:(0,n.jsx)(v,{label:\"05 — What We Built\",heading:\"Three things. Nothing more.\",body:\"A structured, searchable feed where listings don't disappear. A protected contact reveal — your phone number never shown, only a WhatsApp link built server-side. And it's free, always. No promoted listings, no ads, no premium tier.\",illustration:(0,n.jsx)(g,{inView:b.inView}),inView:b.inView})}),(0,n.jsx)(\"section\",{className:\"bg-white border-b border-border\",children:(0,n.jsxs)(\"div\",{className:\"container mx-auto px-4 py-16 max-w-5xl\",children:[(0,n.jsx)(o.E.div,{variants:e(8,d.duration.entrance),initial:\"hidden\",whileInView:\"show\",viewport:d.viewport,children:(0,n.jsx)(p,{children:\"06 — Who Built It\"})}),(0,n.jsx)(o.E.div,{variants:s(d.stagger.normal),initial:\"hidden\",whileInView:\"show\",viewport:d.viewport,className:\"mt-6 max-w-xl\",children:(0,n.jsx)(o.E.div,{variants:a(d.duration.entrance,.05),children:(0,n.jsxs)(\"div\",{className:\"flex items-start gap-4 p-5 rounded-lg border border-border bg-surface\",children:[(0,n.jsx)(\"div\",{className:\"w-10 h-10 rounded-full border-2 border-border bg-white flex items-center justify-center flex-shrink-0 text-sm font-bold text-neutral-text font-heading\",children:\"A\"}),(0,n.jsxs)(\"div\",{children:[(0,n.jsx)(\"p\",{className:\"text-sm font-semibold text-neutral-text\",children:\"Akshit Kala\"}),(0,n.jsx)(\"p\",{className:\"text-xs text-neutral-muted mt-0.5\",children:\"Student \\xb7 Solo builder \\xb7 Built this because it annoyed him\"}),(0,n.jsx)(\"p\",{className:\"text-sm text-neutral-muted mt-3 leading-relaxed\",children:\"No team. No funding. Built entirely from personal frustration during a semester where every attempt to sell or find something on campus ended the same way — a WhatsApp scroll that went nowhere.\"})]})]})})})]})}),(0,n.jsx)(\"section\",{className:\"bg-white\",children:(0,n.jsx)(o.E.div,{variants:e(6,d.duration.entrance),initial:\"hidden\",whileInView:\"show\",viewport:d.viewport,className:\"container mx-auto px-4 py-10 max-w-5xl\",children:(0,n.jsxs)(\"p\",{className:\"text-sm text-neutral-muted\",children:[\"Questions or ideas?\",\" \",(0,n.jsx)(i.default,{href:\"/contact\",className:\"text-primary underline underline-offset-2 hover:text-primary-hover focus:outline-none focus:ring-2 focus:ring-primary rounded\",children:\"Reach out\"}),\". We read everything.\"]})})})]})}},3106:function(e,t,r){\"use stri